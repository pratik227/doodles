{
  "compilerOptions": {
    "target": "es2022",
    "module": "preserve",
    "moduleResolution": "bundler",
    "lib": [
      "es2022",
      "dom",
      "dom.iterable"
    ],
    "types": [
      "node"
    ],
    "strict": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "isolatedDeclarations": false,
    "noEmit": true,
    "jsx": "react-jsx"
  },
  "include": [
    "src",
    "web",
    "bin",
    "scripts",
    "test",
    "examples",
    "*.config.ts"
  ]
}
